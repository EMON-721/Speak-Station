# Names/placeholders only. Real values belong in Cloudflare Worker Secrets.
# Never copy a secret into NEXT_PUBLIC_*, VITE_*, source, GitHub variables,
# command arguments, a screenshot, a log, or a support message.
AUTH_MODE=google
APP_ORIGIN=https://your-worker.example.com
ADMIN_EMAIL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
# Optional provider fallback; prefer the already encrypted saved connection.
GEMINI_API_KEY=
# Optional separate signing key; otherwise the existing encryption secret is reused.
PRACTICE_RECEIPT_SECRET=
CONTENT_UPDATES_ALLOWED=disabled
